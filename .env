# ============================================
# Configuración de Correo (Email Service)
# ============================================

# Correo del remitente (notificaciones)
EMAIL_SENDER=info@eclick.com.mx

# Contraseña del correo (credencial SMTP)
EMAIL_PASSWORD=J;5THH}G!#.fc^lb

# Servidor SMTP de correo
EMAIL_SMTP_SERVER=mail.eclick.com.mx

# Puerto SMTP (465 para SSL/TLS)
EMAIL_SMTP_PORT=465

# Usar TLS para conexión segura
EMAIL_USE_TLS=true

# ============================================
# Configuración de PostgreSQL
# ============================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=certificados_pac
DB_USER=postgres
DB_PASSWORD=12345678
DB_SSL_MODE=prefer
